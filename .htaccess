Options -Indexes
RewriteEngine On

<Files ".env">
    Require all denied
</Files>

RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://voxform.co.uk%{REQUEST_URI} [R=301,L]

ErrorDocument 503 /Maintenance.html

RewriteCond %{DOCUMENT_ROOT}/maint.flag -f
RewriteCond %{REQUEST_URI} !^/Maintenance\.html$
RewriteCond %{REQUEST_URI} !^/Assets/
RewriteCond %{REQUEST_URI} !^/Maintenance/
RewriteCond %{REQUEST_URI} !^/Header/
RewriteCond %{REQUEST_URI} !^/Footer/
RewriteCond %{REQUEST_URI} !^/webhook\.php$
RewriteCond %{REMOTE_ADDR} !^XXX\.XXX\.XXX\.XXX$
RewriteCond %{REMOTE_ADDR} !^XXXX:XXXX:XXXX:XXXX
RewriteRule ^ - [R=503,L]

Header always set Retry-After "3600" env=REDIRECT_STATUS

RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>